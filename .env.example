# Countersign runs with no environment file at all. These override the defaults.
# Every value below is optional.

# Storage. Defaults to local SQLite; set a Postgres URL for a real deployment.
# COUNTERSIGN_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/countersign

# Extraction provider: mock | gemini | groq
# "mock" replays committed fixtures offline and is the default.
# COUNTERSIGN_LLM_PROVIDER=gemini
# COUNTERSIGN_LLM_MODEL=gemini-2.0-flash
# COUNTERSIGN_GEMINI_API_KEY=
# COUNTERSIGN_GROQ_API_KEY=

# Prompt directory to use: v1 | v2
# COUNTERSIGN_PROMPT_VERSION=v2

# Check tolerances
# COUNTERSIGN_PRICE_TOLERANCE_PCT=2.0
# COUNTERSIGN_PRICE_VARIANCE_MAD_THRESHOLD=3.5
# COUNTERSIGN_PRICE_HISTORY_MIN_POINTS=5
# COUNTERSIGN_NEAR_DUPLICATE_WINDOW_DAYS=45
